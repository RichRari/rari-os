# Copy this file to .env and fill it in.

# Your Anthropic API key (console.anthropic.com) — powers the AI brain and Daily Briefing.
ANTHROPIC_API_KEY=

# Optional: which Claude model the AI brain uses.
RARI_OS_MODEL=claude-sonnet-5-5

# Folders the File Integrity Monitor watches, comma-separated.
RARI_OS_WATCH=~/Documents

# Port for the control panel (http://127.0.0.1:PORT)
RARI_OS_PORT=8787
